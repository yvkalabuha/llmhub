# flags shared by every llmhub-* container (T-371 §2.2); included by the per-container files
--network
host
--read-only
--tmpfs
/tmp:rw,noexec,nosuid,size=64m
--cap-drop
ALL
--security-opt
no-new-privileges:true
--pids-limit
256
--restart
unless-stopped
--log-driver
journald
--log-opt
tag={{.Name}}
--label
org.llmhub.release=@RELEASE@
--health-interval
30s
--health-timeout
10s
--health-retries
3
--health-start-period
60s
--health-start-interval
2s
