# ~/.config/llmhub-guard/guard.env (0600) for llmhub-runpod-guard.service (T-372).
# PATHS and the expiry only - never put a key value here. Key files are 0600 (or 0400), one line each.
GUARD_RO_KEY_FILE=/home/USER/.config/runpod/api-key
GUARD_RW_KEY_FILE=/home/USER/.config/runpod/api-key-rw
GUARD_BEFORE=/home/USER/.local/state/llmhub-guard/before.json
# Expiry (REV-S9): planned end of the live test + 6 h, UTC ISO-8601; after it the guard only
# reports. Set in L0, e.g. $(date -u -d '+14 hours' +%Y-%m-%dT%H:%M:%SZ) for an 8 h test.
GUARD_UNTIL=2026-11-05T06:00:00Z
