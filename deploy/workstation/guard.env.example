# ~/.config/llmhub-guard/guard.env (0600) for llmhub-runpod-guard.service (T-372).
# PATHS ONLY - never put a key value here. Key files are 0600 (or 0400), one line each.
GUARD_RO_KEY_FILE=/home/USER/.config/runpod/api-key
GUARD_RW_KEY_FILE=/home/USER/.config/runpod/api-key-rw
GUARD_BEFORE=/home/USER/.local/state/llmhub-guard/before.json
