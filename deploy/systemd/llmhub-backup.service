# T-371 §2.13 (F11): daily consistent copy of state.db inside the running llmhub-api
# container (same uid, umask 0027 -> files 0640). Only `docker exec` into llmhub-api.
[Unit]
Description=llmhub state.db backup
After=docker.service

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/bin/docker exec llmhub-api python -m llmhub backup --config /etc/llmhub/conf/config.yaml --to /var/lib/llmhub/backup --keep 14
